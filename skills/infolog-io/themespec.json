{
  "name": "infolog-io",
  "version": "0.0.1",
  "context": "data-graphics",
  "modes": ["light", "dark", "system"],
  "default_mode": "system",
  "capabilities": [
    "chart", "table", "sparkline", "small-multiples",
    "dot-plot", "strip-plot", "slopegraph", "range-frame-axis"
  ],
  "output_formats": ["html", "png", "pdf"],
  "style_anchor": "single-file-html"
}
